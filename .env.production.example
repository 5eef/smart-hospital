# Copy to .env.production and replace every replace-* value before deployment.
APP_KEY=base64:replace-with-php-artisan-key-generate-show
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
VITE_API_URL=https://api.example.com/api

DB_DATABASE=smart_hospital
DB_USERNAME=smart_hospital
DB_PASSWORD=replace-with-a-long-database-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password

SANCTUM_STATEFUL_DOMAINS=app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

REVERB_APP_ID=smart-hospital-production
REVERB_APP_KEY=replace-with-a-random-reverb-key
REVERB_APP_SECRET=replace-with-a-random-reverb-secret
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=app.example.com

BACKEND_PORT=8001
FRONTEND_PORT=8080
REVERB_PUBLIC_PORT=8081
