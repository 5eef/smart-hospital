# Copy to .env.production and replace every replace-* value before deployment.
APP_KEY=base64:replace-with-php-artisan-key-generate-show
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
VITE_API_URL=https://api.example.com/api
HOSPITAL_TIMEZONE=UTC

DB_DATABASE=smart_hospital
DB_USERNAME=smart_hospital
DB_PASSWORD=replace-with-a-long-database-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password

SANCTUM_STATEFUL_DOMAINS=app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_PROXIES=10.0.0.10

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com

QUEUE_AFTER_COMMIT=true
BACKEND_PORT=8001
FRONTEND_PORT=8080
